{
  "name": "@brave/bravebot-sdk",
  "version": "0.20.0",
  "description": "A thin typed wrapper that runs the bravebot command line and reads its event stream",
  "license": "MPL-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brave/bravebot.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/brave/bravebot/issues"
  },
  "homepage": "https://github.com/brave/bravebot/blob/main/packages/sdk/README.md",
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "node --test --test-timeout=120000 dist/tests/*.test.js",
    "check": "pnpm run typecheck && pnpm run build && pnpm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2"
  }
}
