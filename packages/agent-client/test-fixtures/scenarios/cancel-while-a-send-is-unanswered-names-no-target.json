{
  "name": "cancel-while-a-send-is-unanswered-names-no-target",
  "description": "A cancel issued while a send has no answer yet does not know the target of the turn it starts, so it names none and stops whatever is running.",
  "steps": [
    {"start": "a", "call": "createSession", "args": {"workspace": "work"}},
    {"expectRequest": "info", "method": "agent.info", "params": {}},
    {"send": [{"id": "$info", "ok": {"build": "build-1", "version": "0.14.0", "configured": true, "defaultModel": "stub-model", "home": "/home/person/.bravebot", "capabilities": {"sessionView": {"version": 1, "start": "session.view.start", "scope": "fresh_session", "approvals": ["confirm", "run", "fetch", "ask"], "reconnect": false}, "actionTargets": {"cancel": "expected_target", "questionIds": "session", "trust": "once", "version": 1}}}}]},
    {"expectRequest": "new", "method": "session.new", "params": {"directory": "/work"}},
    {"send": [{"event": "trust.request", "session": "s1", "data": {"directory": "/work", "keeping": null}}, {"id": "$new", "ok": {"session": "s1"}}]},
    {"expectRequest": "view", "method": "session.view.start", "params": {"session": "s1", "version": 1}},
    {"send": [{"event": "session.view.initial", "session": "s1", "data": {"sequence": 0, "turn": 0, "target": 0, "status": "idle", "pending": null, "rows": []}}, {"id": "$view", "ok": {"version": 1}}]},
    {"await": "a", "bindSession": "a"},
    {"start": "send", "call": "send", "session": "a", "args": {"text": "go"}},
    {"expectRequest": "send", "method": "turn.send", "params": {"session": "s1", "prompt": "go"}},
    {"start": "cancel", "call": "cancel", "session": "a"},
    {"expectRequest": "c", "method": "turn.cancel", "params": {"session": "s1"}},
    {"send": [{"id": "$send", "ok": {"turn": 2, "target": 2}}, {"id": "$c", "ok": {}}]},
    {"await": "send", "result": {"turn": 2, "target": 2}},
    {"await": "cancel", "result": {"cancelled": null}}
  ]
}
