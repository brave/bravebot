{
  "name": "reply-targets-the-question-on-screen",
  "description": "A reply for a request that is not displayed, or answering with the wrong form, is refused locally.",
  "steps": [
    {"start": "a", "call": "createSession", "args": {"workspace": "work"}},
    {"expectRequest": "info", "method": "agent.info", "params": {}},
    {"send": [{"id": "$info", "ok": {"build": "build-1", "version": "0.14.0", "configured": true, "defaultModel": "stub-model", "home": "/home/person/.bravebot", "capabilities": {"sessionView": {"version": 1, "start": "session.view.start", "scope": "fresh_session", "approvals": ["confirm", "run", "fetch", "ask"], "reconnect": false}}}}]},
    {"expectRequest": "new", "method": "session.new", "params": {"directory": "/work"}},
    {"send": [{"event": "trust.request", "session": "s1", "data": {"directory": "/work", "keeping": null}}, {"id": "$new", "ok": {"session": "s1"}}]},
    {"expectRequest": "view", "method": "session.view.start", "params": {"session": "s1", "version": 1}},
    {"send": [{"event": "session.view.initial", "session": "s1", "data": {"sequence": 0, "turn": 0, "target": 0, "status": "idle", "pending": null, "rows": []}}, {"id": "$view", "ok": {"version": 1}}]},
    {"await": "a", "bindSession": "a"},
    {"send": [{"event": "session.view.update", "session": "s1", "data": {"sequence": 1, "turn": 1, "target": 1, "status": "running", "pending": null, "rows": [{"id": 1, "turn": 1, "kind": "prompt", "event": null, "data": {"text": "go"}, "resolved": false}]}}, {"event": "session.view.update", "session": "s1", "data": {"sequence": 2, "turn": 1, "target": 1, "status": "waiting", "pending": {"row": 2, "request": 3, "kind": "ask", "supported": true, "data": {"request": 3, "questions": []}}, "rows": [{"id": 2, "turn": 1, "kind": "approval", "event": "ask.request", "data": {"request": 3, "questions": []}, "resolved": false}]}}]},
    {"start": "old", "call": "decide", "session": "a", "args": {"request": 2, "decision": "approve"}},
    {"await": "old", "error": {"name": "StaleActionError"}},
    {"start": "form", "call": "decide", "session": "a", "args": {"request": 3, "decision": "approve"}},
    {"await": "form", "error": {"name": "UnsupportedError"}},
    {"expectNoRequest": true}
  ]
}
