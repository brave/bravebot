{
  "name": "turn-with-fetch-approval",
  "description": "A trusted turn waits on a fetch question, is approved, and ends with a labelled released row.",
  "steps": [
    {"start": "a", "call": "createSession", "args": {"workspace": "work"}},
    {"expectRequest": "info", "method": "agent.info", "params": {}},
    {"send": [{"id": "$info", "ok": {"build": "build-1", "version": "0.14.0", "configured": true, "defaultModel": "stub-model", "home": "/home/person/.bravebot", "capabilities": {"sessionView": {"version": 1, "start": "session.view.start", "scope": "fresh_session", "approvals": ["confirm", "run", "fetch", "ask"], "reconnect": false}}}}]},
    {"expectRequest": "new", "method": "session.new", "params": {"directory": "/work"}},
    {"send": [{"event": "trust.request", "session": "s1", "data": {"directory": "/work", "keeping": null}}, {"id": "$new", "ok": {"session": "s1"}}]},
    {"expectRequest": "view", "method": "session.view.start", "params": {"session": "s1", "version": 1}},
    {"send": [{"event": "session.view.initial", "session": "s1", "data": {"sequence": 0, "turn": 0, "status": "awaiting_trust", "pending": null, "rows": []}}, {"id": "$view", "ok": {"version": 1}}]},
    {"await": "a", "bindSession": "a"},
    {"start": "trust", "call": "answerTrust", "session": "a", "args": {"trusted": true}},
    {"expectRequest": "trust", "method": "trust.reply", "params": {"session": "s1", "trusted": true}},
    {"send": [{"event": "session.view.update", "session": "s1", "data": {"sequence": 1, "turn": 0, "status": "idle", "pending": null, "rows": []}}, {"id": "$trust", "ok": {}}]},
    {"await": "trust"},
    {"expectView": "a", "sequence": 1, "status": "idle"},
    {"start": "send", "call": "send", "session": "a", "args": {"text": "read the docs"}},
    {"expectRequest": "send", "method": "turn.send", "params": {"session": "s1", "prompt": "read the docs"}},
    {"send": [{"event": "session.view.update", "session": "s1", "data": {"sequence": 2, "turn": 1, "status": "running", "pending": null, "rows": [{"id": 1, "turn": 1, "kind": "prompt", "event": null, "data": {"text": "read the docs"}, "resolved": false}]}}, {"id": "$send", "ok": {"turn": 1}}]},
    {"await": "send", "result": {"turn": 1}},
    {"send": [{"event": "tool.started", "session": "s1", "data": {"id": "t1"}}, {"event": "session.view.update", "session": "s1", "data": {"sequence": 3, "turn": 1, "status": "running", "pending": null, "rows": [{"id": 2, "turn": 1, "kind": "activity", "event": "tool.started", "data": {"id": "t1"}, "resolved": false}]}}, {"event": "session.view.update", "session": "s1", "data": {"sequence": 4, "turn": 1, "status": "waiting", "pending": {"row": 3, "request": 7, "kind": "fetch", "supported": true, "data": {"request": 7, "url": "https://example.test/docs", "host": "example.test"}}, "rows": [{"id": 3, "turn": 1, "kind": "approval", "event": "fetch.request", "data": {"request": 7, "url": "https://example.test/docs", "host": "example.test"}, "resolved": false}]}}]},
    {"expectView": "a", "sequence": 4, "status": "waiting", "pending": {"row": 3, "request": 7, "kind": "fetch", "supported": true, "data": {"request": 7, "url": "https://example.test/docs", "host": "example.test"}}, "rows": [{"id": 1, "kind": "prompt"}, {"id": 2, "kind": "activity"}, {"id": 3, "kind": "approval", "resolved": false}]},
    {"start": "decide", "call": "decide", "session": "a", "args": {"request": 7, "decision": "approve"}},
    {"expectRequest": "decide", "method": "fetch.reply", "params": {"session": "s1", "request": 7, "decision": "approve"}},
    {"send": [{"event": "session.view.update", "session": "s1", "data": {"sequence": 5, "turn": 1, "status": "running", "pending": null, "rows": [{"id": 3, "turn": 1, "kind": "approval", "event": "fetch.request", "data": {"request": 7, "url": "https://example.test/docs", "host": "example.test"}, "resolved": true}]}}, {"id": "$decide", "ok": {}}, {"event": "session.view.update", "session": "s1", "data": {"sequence": 6, "turn": 1, "status": "running", "pending": null, "rows": [{"id": 4, "turn": 1, "kind": "quarantined", "event": "quarantined", "data": {"label": "(U,pub)", "origin": "example.test", "text": "page text", "future": [1, 2]}, "resolved": false}]}}, {"event": "session.view.update", "session": "s1", "data": {"sequence": 7, "turn": 1, "status": "completed", "pending": null, "rows": [{"id": 5, "turn": 1, "kind": "reply", "event": "turn.done", "data": {"turn": 1, "text": "done"}, "resolved": false}]}}]},
    {"await": "decide"},
    {"expectView": "a", "sequence": 7, "status": "completed", "pending": null, "rows": [{"id": 1}, {"id": 2}, {"id": 3, "resolved": true, "data": {"request": 7, "url": "https://example.test/docs", "host": "example.test"}}, {"id": 4, "kind": "quarantined", "data": {"label": "(U,pub)", "origin": "example.test", "text": "page text", "future": [1, 2]}}, {"id": 5, "kind": "reply"}]}
  ]
}
