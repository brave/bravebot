{
  "name": "reply-is-sent-once-per-request",
  "description": "A second reply to a request while the first is being sent is refused locally, and only one request is written.",
  "steps": [
    {"start": "a", "call": "createSession", "args": {"workspace": "work"}},
    {"expectRequest": "info", "method": "agent.info", "params": {}},
    {"send": [{"id": "$info", "ok": {"build": "build-1", "version": "0.14.0", "configured": true, "defaultModel": "stub-model", "home": "/home/person/.bravebot", "capabilities": {"sessionView": {"version": 1, "start": "session.view.start", "scope": "fresh_session", "approvals": ["confirm", "run", "fetch", "ask"], "reconnect": false}}}}]},
    {"expectRequest": "new", "method": "session.new", "params": {"directory": "/work"}},
    {"send": [{"event": "trust.request", "session": "s1", "data": {"directory": "/work", "keeping": null}}, {"id": "$new", "ok": {"session": "s1"}}]},
    {"expectRequest": "view", "method": "session.view.start", "params": {"session": "s1", "version": 1}},
    {"send": [{"event": "session.view.initial", "session": "s1", "data": {"sequence": 0, "turn": 0, "target": 0, "status": "idle", "pending": null, "rows": []}}, {"id": "$view", "ok": {"version": 1}}]},
    {"await": "a", "bindSession": "a"},
    {"start": "send", "call": "send", "session": "a", "args": {"text": "go"}},
    {"expectRequest": "send", "method": "turn.send", "params": {"session": "s1", "prompt": "go"}},
    {"send": [{"event": "session.view.update", "session": "s1", "data": {"sequence": 1, "turn": 1, "target": 1, "status": "running", "pending": null, "rows": [{"id": 1, "turn": 1, "kind": "prompt", "event": null, "data": {"text": "go"}, "resolved": false}]}}, {"id": "$send", "ok": {"turn": 1, "target": 1}}]},
    {"await": "send"},
    {"send": [{"event": "session.view.update", "session": "s1", "data": {"sequence": 2, "turn": 1, "target": 1, "status": "waiting", "pending": {"row": 2, "request": 4, "kind": "confirm", "supported": true, "data": {"request": 4, "path": "out.txt", "intent": "create", "changes": []}}, "rows": [{"id": 2, "turn": 1, "kind": "approval", "event": "confirm.request", "data": {"request": 4, "path": "out.txt", "intent": "create", "changes": []}, "resolved": false}]}}]},
    {"start": "first", "call": "decide", "session": "a", "args": {"request": 4, "decision": "approve"}},
    {"start": "second", "call": "decide", "session": "a", "args": {"request": 4, "decision": "approve"}},
    {"await": "second", "error": {"name": "StaleActionError"}},
    {"expectRequest": "reply", "method": "confirm.reply", "params": {"session": "s1", "request": 4, "decision": "approve"}},
    {"send": [{"id": "$reply", "ok": {}}]},
    {"await": "first"},
    {"expectNoRequest": true}
  ]
}
