{
  "name": "a-turn-can-finish-before-its-send-response",
  "description": "A turn that completes entirely before the send response arrives leaves its rows in order and the view completed.",
  "steps": [
    {"start": "a", "call": "createSession", "args": {"workspace": "work"}},
    {"expectRequest": "info", "method": "agent.info", "params": {}},
    {"send": [{"id": "$info", "ok": {"build": "build-1", "version": "0.14.0", "configured": true, "defaultModel": "stub-model", "home": "/home/person/.bravebot", "capabilities": {"sessionView": {"version": 1, "start": "session.view.start", "scope": "fresh_session", "approvals": ["confirm", "run", "fetch", "ask"], "reconnect": false}}}}]},
    {"expectRequest": "new", "method": "session.new", "params": {"directory": "/work"}},
    {"send": [{"event": "trust.request", "session": "s1", "data": {"directory": "/work", "keeping": null}}, {"id": "$new", "ok": {"session": "s1"}}]},
    {"expectRequest": "view", "method": "session.view.start", "params": {"session": "s1", "version": 1}},
    {"send": [{"event": "session.view.initial", "session": "s1", "data": {"sequence": 0, "turn": 0, "status": "idle", "pending": null, "rows": []}}, {"id": "$view", "ok": {"version": 1}}]},
    {"await": "a", "bindSession": "a"},
    {"start": "send", "call": "send", "session": "a", "args": {"text": "quick"}},
    {"expectRequest": "send", "method": "turn.send", "params": {"session": "s1", "prompt": "quick"}},
    {"send": [{"event": "session.view.update", "session": "s1", "data": {"sequence": 1, "turn": 1, "status": "running", "pending": null, "rows": [{"id": 1, "turn": 1, "kind": "prompt", "event": null, "data": {"text": "quick"}, "resolved": false}]}}, {"event": "session.view.update", "session": "s1", "data": {"sequence": 2, "turn": 1, "status": "running", "pending": null, "rows": [{"id": 2, "turn": 1, "kind": "narration", "event": "narration", "data": {"text": "early output"}, "resolved": false}]}}, {"event": "session.view.update", "session": "s1", "data": {"sequence": 3, "turn": 1, "status": "completed", "pending": null, "rows": [{"id": 3, "turn": 1, "kind": "reply", "event": "turn.done", "data": {"turn": 1}, "resolved": false}]}}, {"id": "$send", "ok": {"turn": 1}}]},
    {"await": "send", "result": {"turn": 1}},
    {"expectView": "a", "sequence": 3, "status": "completed", "rows": [{"id": 1, "kind": "prompt"}, {"id": 2, "kind": "narration"}, {"id": 3, "kind": "reply"}]}
  ]
}
