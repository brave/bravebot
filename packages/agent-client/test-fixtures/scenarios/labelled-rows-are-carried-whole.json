{
  "name": "labelled-rows-are-carried-whole",
  "description": "A released payload keeps its label, origin, reach and fields the client does not know, and a replacement of its row carries the new payload whole.",
  "steps": [
    {"start": "a", "call": "createSession", "args": {"workspace": "work"}},
    {"expectRequest": "info", "method": "agent.info", "params": {}},
    {"send": [{"id": "$info", "ok": {"build": "build-1", "version": "0.14.0", "configured": true, "defaultModel": "stub-model", "home": "/home/person/.bravebot", "capabilities": {"sessionView": {"version": 1, "start": "session.view.start", "scope": "fresh_session", "approvals": ["confirm", "run", "fetch", "ask"], "reconnect": false}}}}]},
    {"expectRequest": "new", "method": "session.new", "params": {"directory": "/work"}},
    {"send": [{"event": "trust.request", "session": "s1", "data": {"directory": "/work", "keeping": null}}, {"id": "$new", "ok": {"session": "s1"}}]},
    {"expectRequest": "view", "method": "session.view.start", "params": {"session": "s1", "version": 1}},
    {"send": [{"event": "session.view.initial", "session": "s1", "data": {"sequence": 0, "turn": 0, "status": "idle", "pending": null, "rows": []}}, {"id": "$view", "ok": {"version": 1}}]},
    {"await": "a", "bindSession": "a"},
    {"send": [{"event": "session.view.update", "session": "s1", "data": {"sequence": 1, "turn": 1, "status": "running", "pending": null, "rows": [{"id": 1, "turn": 1, "kind": "prompt", "event": null, "data": {"text": "go"}, "resolved": false}]}}, {"event": "session.view.update", "session": "s1", "data": {"sequence": 2, "turn": 1, "status": "running", "pending": null, "rows": [{"id": 2, "turn": 1, "kind": "quarantined", "event": "quarantined", "data": {"label": "(U,pub)", "origin": "example.test", "text": "page text", "preview": ["line one"], "reach": "not_the_planner", "future": [1, {"k": "v"}]}, "resolved": false}]}}, {"event": "session.view.update", "session": "s1", "data": {"sequence": 3, "turn": 1, "status": "running", "pending": null, "rows": [{"id": 2, "turn": 1, "kind": "quarantined", "event": "quarantined", "data": {"label": "(U,pub)", "origin": "example.test", "text": "page text", "preview": ["line one"], "reach": "moved", "future": [1, {"k": "v"}]}, "resolved": false}]}}]},
    {"expectView": "a", "sequence": 3, "rows": [{"id": 1}, {"id": 2, "kind": "quarantined", "data": {"label": "(U,pub)", "origin": "example.test", "text": "page text", "preview": ["line one"], "reach": "moved", "future": [1, {"k": "v"}]}}]}
  ]
}
