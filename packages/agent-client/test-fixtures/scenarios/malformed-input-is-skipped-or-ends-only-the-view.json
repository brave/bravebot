{
  "name": "malformed-input-is-skipped-or-ends-only-the-view",
  "description": "Unreadable lines are skipped; a malformed view update ends that view only.",
  "steps": [
    {"start": "a", "call": "createSession", "args": {"workspace": "one"}},
    {"expectRequest": "info", "method": "agent.info", "params": {}},
    {"send": [{"id": "$info", "ok": {"build": "build-1", "version": "0.14.0", "configured": true, "defaultModel": "stub-model", "home": "/home/person/.bravebot", "capabilities": {"sessionView": {"version": 1, "start": "session.view.start", "scope": "fresh_session", "approvals": ["confirm", "run", "fetch", "ask"], "reconnect": false}}}}]},
    {"expectRequest": "new", "method": "session.new", "params": {"directory": "/one"}},
    {"send": [{"event": "trust.request", "session": "s1", "data": {"directory": "/one", "keeping": null}}, {"id": "$new", "ok": {"session": "s1"}}]},
    {"expectRequest": "view", "method": "session.view.start", "params": {"session": "s1", "version": 1}},
    {"send": [{"event": "session.view.initial", "session": "s1", "data": {"sequence": 0, "turn": 0, "target": 0, "status": "idle", "pending": null, "rows": []}}, {"id": "$view", "ok": {"version": 1}}]},
    {"await": "a", "bindSession": "a"},
    {"start": "b", "call": "createSession", "args": {"workspace": "two"}},
    {"expectRequest": "new", "method": "session.new", "params": {"directory": "/two"}},
    {"send": [{"event": "trust.request", "session": "s2", "data": {"directory": "/two", "keeping": null}}, {"id": "$new", "ok": {"session": "s2"}}]},
    {"expectRequest": "view", "method": "session.view.start", "params": {"session": "s2", "version": 1}},
    {"send": [{"event": "session.view.initial", "session": "s2", "data": {"sequence": 0, "turn": 0, "target": 0, "status": "idle", "pending": null, "rows": []}}, {"id": "$view", "ok": {"version": 1}}]},
    {"await": "b", "bindSession": "b"},
    {"send": ["this is not json", "[1,2]", "{\"id\": 99, \"ok\": {}}", "{\"event\": 5}", {"event": "agent.ready", "data": {}}]},
    {"expectView": "a", "sequence": 0, "ended": null},
    {"send": [{"event": "session.view.update", "session": "s1", "data": {"sequence": 1, "turn": 1, "target": 1, "status": "frozen", "pending": null, "rows": []}}, {"event": "session.view.update", "session": "s2", "data": {"sequence": 1, "turn": 1, "target": 1, "status": "running", "pending": null, "rows": [{"id": 1, "turn": 1, "kind": "prompt", "event": null, "data": {"text": "ok"}, "resolved": false}]}}]},
    {"expectView": "a", "sequence": 0, "ended": {"reason": "protocol_error"}},
    {"expectView": "b", "sequence": 1, "status": "running", "ended": null},
    {"start": "info", "call": "raw", "args": {"method": "agent.info"}},
    {"expectRequest": "i", "method": "agent.info", "params": {}},
    {"send": [{"id": "$i", "ok": {"still": "answering"}}]},
    {"await": "info", "result": {"still": "answering"}}
  ]
}
