{
  "name": "interleaved-sessions",
  "description": "Two sessions and a probe have requests in flight at once, the responses return in the opposite order, and the updates interleave.",
  "steps": [
    {"start": "a", "call": "createSession", "args": {"workspace": "one"}},
    {"expectRequest": "info", "method": "agent.info", "params": {}},
    {"send": [{"id": "$info", "ok": {"build": "build-1", "version": "0.14.0", "configured": true, "defaultModel": "stub-model", "home": "/home/person/.bravebot", "capabilities": {"sessionView": {"version": 1, "start": "session.view.start", "scope": "fresh_session", "approvals": ["confirm", "run", "fetch", "ask"], "reconnect": false}}}}]},
    {"expectRequest": "new", "method": "session.new", "params": {"directory": "/one"}},
    {"send": [{"event": "trust.request", "session": "s1", "data": {"directory": "/one", "keeping": null}}, {"id": "$new", "ok": {"session": "s1"}}]},
    {"expectRequest": "view", "method": "session.view.start", "params": {"session": "s1", "version": 1}},
    {"send": [{"event": "session.view.initial", "session": "s1", "data": {"sequence": 0, "turn": 0, "status": "idle", "pending": null, "rows": []}}, {"id": "$view", "ok": {"version": 1}}]},
    {"await": "a", "bindSession": "a"},
    {"start": "b", "call": "createSession", "args": {"workspace": "two"}},
    {"expectRequest": "new", "method": "session.new", "params": {"directory": "/two"}},
    {"send": [{"event": "trust.request", "session": "s2", "data": {"directory": "/two", "keeping": null}}, {"id": "$new", "ok": {"session": "s2"}}]},
    {"expectRequest": "view", "method": "session.view.start", "params": {"session": "s2", "version": 1}},
    {"send": [{"event": "session.view.initial", "session": "s2", "data": {"sequence": 0, "turn": 0, "status": "idle", "pending": null, "rows": []}}, {"id": "$view", "ok": {"version": 1}}]},
    {"await": "b", "bindSession": "b"},
    {"start": "sa", "call": "send", "session": "a", "args": {"text": "first"}},
    {"start": "sb", "call": "send", "session": "b", "args": {"text": "second"}},
    {"expectRequest": "ra", "method": "turn.send", "params": {"session": "s1", "prompt": "first"}},
    {"expectRequest": "rb", "method": "turn.send", "params": {"session": "s2", "prompt": "second"}},
    {"start": "probe", "call": "raw", "args": {"method": "models.list"}},
    {"expectRequest": "rp", "method": "models.list", "params": {}},
    {"send": [{"id": "$rp", "ok": {"marker": "models"}}, {"event": "session.view.update", "session": "s2", "data": {"sequence": 1, "turn": 1, "status": "running", "pending": null, "rows": [{"id": 1, "turn": 1, "kind": "prompt", "event": null, "data": {"text": "second"}, "resolved": false}]}}, {"id": "$rb", "ok": {"turn": 11}}, {"event": "session.view.update", "session": "s1", "data": {"sequence": 1, "turn": 1, "status": "running", "pending": null, "rows": [{"id": 1, "turn": 1, "kind": "prompt", "event": null, "data": {"text": "first"}, "resolved": false}]}}, {"id": "$ra", "ok": {"turn": 12}}]},
    {"await": "sb", "result": {"turn": 11}},
    {"await": "sa", "result": {"turn": 12}},
    {"await": "probe", "result": {"marker": "models"}},
    {"send": [{"event": "session.view.update", "session": "s1", "data": {"sequence": 2, "turn": 1, "status": "waiting", "pending": {"row": 2, "request": 1, "kind": "confirm", "supported": true, "data": {"request": 1, "path": "a.txt"}}, "rows": [{"id": 2, "turn": 1, "kind": "approval", "event": "confirm.request", "data": {"request": 1, "path": "a.txt"}, "resolved": false}]}}, {"event": "session.view.update", "session": "s2", "data": {"sequence": 2, "turn": 1, "status": "completed", "pending": null, "rows": [{"id": 2, "turn": 1, "kind": "reply", "event": "turn.done", "data": {"turn": 1}, "resolved": false}]}}]},
    {"expectView": "a", "sequence": 2, "status": "waiting", "pending": {"request": 1}, "rows": [{"data": {"text": "first"}}, {"kind": "approval"}]},
    {"expectView": "b", "sequence": 2, "status": "completed", "pending": null, "rows": [{"data": {"text": "second"}}, {"kind": "reply"}]}
  ]
}
