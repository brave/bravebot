{
  "manifest_version": 3,
  "name": "BraveBot",
  "version": "0.1.0",
  "description": "Lets a BraveBot session read your open tabs, and your history and bookmarks where you allow it.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "history",
    "bookmarks",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
