{
  "manifest_version": 3,
  "name": "BraveBot",
  "version": "0.1.0",
  "description": "Lets BraveBot read, organize, navigate and download in Brave, and delete data, in groups of tools each off until you turn it on.",
  "key": "",
  "minimum_chrome_version": "135",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "tabs",
    "webNavigation",
    "history",
    "topSites",
    "sessions",
    "tabGroups",
    "bookmarks",
    "readingList",
    "webRequest",
    "privacy",
    "contentSettings",
    "fontSettings",
    "system.cpu",
    "system.memory",
    "system.display",
    "system.storage",
    "idle",
    "power",
    "browsingData",
    "downloads",
    "pageCapture",
    "scripting",
    "search",
    "cookies",
    "contextMenus",
    "desktopCapture",
    "userScripts"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "BraveBot",
    "default_popup": "popup.html"
  },
  "commands": {
    "turn-everything-off": {
      "description": "Turn every BraveBot group off"
    }
  }
}
