{
  "manifest_version": 3,
  "name": "BraveBot Trusted Input",
  "version": "0.1.0",
  "description": "Sends real mouse and keyboard input, a picture of a whole page, its console or a chosen file, when BraveBot asks and you allow it.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger"
  ],
  "externally_connectable": {
    "ids": [
      "fcjamhpiedeihbbbpndcjngkjaogfgep"
    ]
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BraveBot Trusted Input",
    "default_popup": "popup.html"
  }
}
