# direnv — contains SERVICES_KEY_AICHAT. Never commit.
.envrc
.direnv/

# Environment files
.env
.env.*
!.env.example

# Rust
/target/
**/*.rs.bk
*.pdb

# The fuzz package's build output, the inputs the fuzzer grows, the crashes it finds and its
# coverage data. What is kept lives in fuzz/seeds and fuzz/regressions.
/fuzz/target/
/fuzz/artifacts/
/fuzz/corpus/
/fuzz/coverage/

# Build output
/dist/

# Linked worktrees, such as the ones the pr-fix and rebase skills create
/.worktrees/

# Node (npm distribution wrapper)
node_modules/

# macOS
.DS_Store

# Python (the spec-check scripts)
__pycache__/

# Generated by `make init`: symlinks from agents/ into each tool's discovery dir.
# The source of truth is agents/, so these are derived state and never committed.
.claude/
.agents/
.bravebot/
.cursor/
bravebot-export-*.md
/AGENTS.md

# Editors
*.swp
*.swo
.idea/
