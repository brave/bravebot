{
  "name": "@brave/bravebot",
  "version": "0.10.0",
  "description": "A general-purpose agent with structural resistance to indirect prompt injection",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brave/bravebot.git"
  },
  "bugs": {
    "url": "https://github.com/brave/bravebot/issues"
  },
  "homepage": "https://github.com/brave/bravebot#readme",
  "bin": {
    "bravebot": "npm/bin/bravebot.js"
  },
  "files": [
    "npm/bin",
    "npm/scripts",
    "README.md",
    "docs/*.md",
    "docs/best-practices",
    "docs/design",
    "docs/development",
    "docs/specs",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node npm/scripts/postinstall.js",
    "lint:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-package-names --validate-integrity",
    "lint:lockfile:website": "lockfile-lint --path docs/website/package-lock.json --type npm --allowed-hosts npm --validate-https --validate-package-names --validate-integrity --allowed-package-name-aliases image-size:image-size-next react-helmet-async:@slorber/react-helmet-async react-loadable:@docusaurus/react-loadable",
    "lint:lockfile:ui": "lockfile-lint --path ui/package-lock.json --type npm --allowed-hosts npm --validate-https --validate-package-names --validate-integrity"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "lockfile-lint": "^5.0.1"
  }
}
