{
  "contestants": [
    {"name": "bravebot-bedrock", "tool": "bravebot", "model": "${BENCH_BEDROCK_MODEL}",
     "args": ["--safe", "--settings", "${BENCH_BRAVEBOT_SETTINGS}"]},
    {"name": "bravebot-anthropic", "tool": "bravebot", "model": "anthropic/claude-sonnet-5-5", "args": ["--safe"]},
    {"name": "bravebot-anthropic-configured", "tool": "bravebot", "model": "anthropic/claude-sonnet-5-5",
     "configured": true, "baseline": "bravebot-anthropic",
     "args": ["--settings", "${BENCH_ANTHROPIC_SETTINGS}"]},
    {"name": "bravebot-brave", "tool": "bravebot", "model": "claude-3-sonnet", "args": ["--safe"],
     "versus": "bravebot-anthropic"},
    {"name": "bravebot-openrouter", "tool": "bravebot", "model": "openrouter/anthropic/claude-sonnet-5.5", "args": ["--safe"],
     "versus": "bravebot-anthropic"},
    {"name": "bravebot-openai", "tool": "bravebot", "model": "openai/gpt-5.6-luna", "args": ["--safe"], "weights": "openai"},
    {"name": "opencode-bedrock", "tool": "opencode", "model": "amazon-bedrock/${BENCH_BEDROCK_MODEL}",
     "env": {"OPENCODE_CONFIG": "${BENCH_OPENCODE_CONFIG}"}},
    {"name": "claude-bare", "tool": "claude", "args": ["--bare"]},
    {"name": "codex", "tool": "codex", "args": ["--ignore-user-config"]},
    {"name": "reference-openrouter", "tool": "reference", "model": "anthropic/claude-sonnet-5.5"},
    {"name": "bravebot-fake-endpoint", "tool": "bravebot", "fake_endpoint": true, "args": ["--safe"]},
    {"name": "reference-fake-endpoint", "tool": "reference", "fake_endpoint": true, "retry_wait": 1}
  ]
}
