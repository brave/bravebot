#!/bin/sh
# Run a script with a Python of at least 3.11, which is what `tomllib` and the scripts here need.
#
# A bare `python3` is whatever the caller's PATH finds first. A hook or an editor started outside a
# login shell does not see Homebrew, finds macOS's /usr/bin/python3 (3.9), and the script stops on
# `ModuleNotFoundError: No module named 'tomllib'`. This looks for a newer interpreter in the usual
# places and fails with a message that names the requirement when there is none.
#
# Usage: contrib/py <script> [args...]

for candidate in \
    python3.14 python3.13 python3.12 python3.11 python3 \
    /opt/homebrew/bin/python3.14 /opt/homebrew/bin/python3.13 \
    /opt/homebrew/bin/python3.12 /opt/homebrew/bin/python3.11 \
    /usr/local/bin/python3.14 /usr/local/bin/python3.13 \
    /usr/local/bin/python3.12 /usr/local/bin/python3.11; do
    if command -v "$candidate" >/dev/null 2>&1 &&
        "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
        exec "$candidate" "$@"
    fi
done

echo "contrib/py: Python 3.11 or newer is required (tomllib); none found on PATH or in the usual" >&2
echo "Homebrew locations. Install one, for example 'brew install python@3.12'." >&2
exit 127
