# Template for direnv. Copy and fill in real values:
#
#   cp contrib/envrc.example .envrc && direnv allow
#
# .envrc itself is gitignored; never commit real key material.

# ---------------------------------------------------------------------------
# Which GitHub account gh acts as. Only needed if you have more than one, and
# commented out because most people do not.
#
# gh reads no git config, so the account it has active is not necessarily the
# one git commits as. The two disagreeing is quiet until it is expensive: the
# commits are authored correctly and the pull request opened after the push
# comes from the other account, and a pull request's author cannot be
# reassigned, only closed and opened again.
#
# Give each account its own config directory, then name one here:
#
#   GH_CONFIG_DIR="$HOME/.config/gh-<account>" gh auth login
#
# A directory rather than GH_TOKEN because direnv exports reach every process
# started here, including bravebot's own `run`, and a path is not a secret:
# gh reads the keyring per invocation. For one command against another
# account, prefix that command instead of editing this line.
# ---------------------------------------------------------------------------
#export GH_CONFIG_DIR="$HOME/.config/gh-<account>"

# ---------------------------------------------------------------------------
# Which environment to use. This is the only line to change day to day.
#
# Three things have to agree, which is why they are set together rather than
# one at a time:
#
#   - the services key, issued for exactly one environment. Used against
#     another it returns 401 error 40101, "Invalid services key": the
#     signature is well formed, the credential simply is not accepted there.
#   - the aichat host.
#
# Override for one command without editing this file:
#
#   BRAVEBOT_ENV=prod direnv exec . bravebot doctor
# ---------------------------------------------------------------------------
export BRAVEBOT_ENV="${BRAVEBOT_ENV:-dev}"

# --- dev -------------------------------------------------------------------
# Hosts resolve on the VPN only; off-VPN the names do not resolve at all.
DEV_SERVICES_KEY="replace-me"
DEV_KEY_ID="replace-me"
DEV_ENDPOINT="https://ai-chat.bsg.brave.software"

# --- prod ------------------------------------------------------------------
PROD_SERVICES_KEY="replace-me"
PROD_KEY_ID="replace-me"
PROD_ENDPOINT="https://ai-chat.bsg.brave.com"

# ---------------------------------------------------------------------------
# Selection. An unrecognised BRAVEBOT_ENV fails here rather than silently leaving
# the variables unset, which would surface later as a confusing 401.
# ---------------------------------------------------------------------------
case "$BRAVEBOT_ENV" in
  dev)
    export SERVICES_KEY_AICHAT="$DEV_SERVICES_KEY"
    export BRAVE_SERVICES_KEY_ID="$DEV_KEY_ID"
    export BRAVE_AI_CHAT_ENDPOINT="$DEV_ENDPOINT"
    ;;
  prod)
    export SERVICES_KEY_AICHAT="$PROD_SERVICES_KEY"
    export BRAVE_SERVICES_KEY_ID="$PROD_KEY_ID"
    export BRAVE_AI_CHAT_ENDPOINT="$PROD_ENDPOINT"
    ;;
  *)
    echo "BRAVEBOT_ENV must be 'dev' or 'prod', got '$BRAVEBOT_ENV'" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

# Point the free endpoint at a locally running backend instead, e.g.
# export BRAVE_AI_CHAT_ENDPOINT="http://127.0.0.1:8000"
#
# Brave's premium service needs no entry here. Its host is compiled in (the dev
# one for both environments for now, as DEV_PREMIUM_ENDPOINT and
# PROD_PREMIUM_ENDPOINT in crates/config/src/lib.rs), and its key is not
# configuration: each person stores their own with `bravebot auth login brave`.
# Without a key every request goes to the free endpoint, signed with the services
# key. BRAVE_AI_CHAT_PREMIUM_ENDPOINT, exported here, replaces the compiled-in
# host with another Brave one; a host that is not Brave's is never sent the key.

# Optional. This is the model requested when nothing else says, and the value
# below is the one already built in, so there is nothing to set unless a
# different default is wanted.
#
# Model to request from POST /v1/chat/completions when the user has not chosen
# one. `/model` in the interface picks from what GET /v1/models lists and that
# choice wins, so this is the fallback rather than the setting. It is the default
# for every service, Bedrock and a provider block's gateways as well as this one.
#
# "automatic-bravebot" lets the server triage per request for this agent, and is what an
# unrecognised name is reset to anyway. Leo uses "automatic" for a different routing policy.
#
# A default, so a "model" key in any settings file and a /model pick both outrank
# it. It outranks the value baked in at build time, and a "model" key outranks
# both.
#
# The model requested is not necessarily the model used: some entries are
# weighted ensembles that resolve randomly, and "automatic-bravebot" itself picks per
# request. Trust the model reported in the response, which `--trace`
# prints.
#
# Non-premium callers get a metered daily allowance of premium-tier automatic
# selections; once spent, requesting a premium model returns 403 error 40301. Free
# models such as llama-3-8b-instruct always work. GET /v1/models reports which is
# which in an "access" field when called with Brave-Product: bravebot.
#export BRAVEBOT_DEFAULT_MODEL="automatic-bravebot"

# ---------------------------------------------------------------------------
# Crash reports. The submission URL of the Backtrace project a release build
# sends them to, token included. Optional: a build without it writes and sends
# nothing, which is what a build from source should do.
#
# Baked into the binary at build time and read from nowhere at run time, so
# exporting it when starting a binary changes nothing. Releases are built by
# the Jenkins job `brave-bot-build`, which needs the same variable set; this
# file only covers a build made here, `make all-platforms` included.
#
# Leave it commented out for day-to-day work. A build that has it sends your
# own panics too, marked as debug builds, and a program the agent runs from a
# shell that exports it inherits the token.
#
# Created in the Backtrace console under Project settings > API tokens, with
# only the capability to submit errors:
#
#   export BACKTRACE_SUBMIT_URL="https://submit.backtrace.io/<universe>/<token>/json"
# ---------------------------------------------------------------------------
